# =============================================================================
# VisionAttend · Environment template
# -----------------------------------------------------------------------------
# Copy this file to `.env` at the repo root and fill in real values:
#     cp .env.example .env
#
# The same file is consumed by:
#   - FastAPI backend  (pydantic-settings, see backend/app/config/settings.py)
#   - Vite frontend    (VITE_* keys only; envDir is pinned to the repo root)
# =============================================================================

# --- Backend: application ----------------------------------------------------
APP_NAME=VisionAttend
APP_ENV=development
APP_VERSION=1.0.0
API_V1_PREFIX=/api/v1

# --- Backend: server ---------------------------------------------------------
HOST=127.0.0.1
PORT=8000
DEBUG=true

# --- Backend: database -------------------------------------------------------
# postgresql+psycopg2://USER:PASSWORD@HOST:PORT/DBNAME
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/attendai

# --- Backend: security -------------------------------------------------------
# REQUIRED in production. Generate with:
#     python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=replace-with-a-strong-random-secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Backend: CORS -----------------------------------------------------------
# JSON array of allowed origins. Include the Vite dev server and Electron schemes.
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","http://localhost:5173","http://127.0.0.1:5173","app://.","file://"]

# --- Backend: logging --------------------------------------------------------
LOG_LEVEL=INFO

# --- Backend: storage --------------------------------------------------------
# Local writable directory for dataset images and persisted artifacts.
STORAGE_DIR=./data/storage

# --- Frontend (Vite) ---------------------------------------------------------
# Only keys prefixed with VITE_ are exposed to the renderer bundle.
VITE_API_BASE_URL=http://127.0.0.1:8000/api/v1
